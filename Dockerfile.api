FROM node:20-alpine
WORKDIR /app

# Copy only the server package files first to leverage Docker layer caching
COPY server/package.json server/package-lock.json* ./
RUN npm install

# Copy the rest of the server source
COPY server/ .

EXPOSE 3001

# Run with ts-node so no separate build step is needed in the container.
# For production, consider: RUN npm run build && CMD ["node", "dist/index.js"]
CMD ["npx", "ts-node", "index.ts"]
